{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/data/*", "*.css", "*.js", "*.png", "*.json", "*.csv"]
  },
  "routes": [
    {
      "route": "/data/testing_manifest.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/data/metrics_summary.csv",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".csv": "text/csv",
    ".png": "image/png"
  }
}
